{
  "name": "@avito/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "telegram:setup": "tsx src/cli/telegram-setup.ts",
    "telegram:owner": "tsx src/cli/telegram-owner.ts",
    "dev:telegram": "tsx src/dev/telegram.ts"
  },
  "dependencies": {
    "@avito/contracts": "workspace:*",
    "@avito/database": "workspace:*",
    "@avito/domain": "workspace:*",
    "@avito/integrations": "workspace:*",
    "@avito/observability": "workspace:*",
    "@avito/queue": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "bullmq": "^5.58.7",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.1",
    "telegraf": "^4.16.3",
    "zod": "^4.1.11"
  }
}
