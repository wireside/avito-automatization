  "dependencies": {
    "@avito/contracts": "workspace:*",
    "@fontsource/inter": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "@tanstack/vue-query": "^5.90.2",
    "@zxing/browser": "^0.1.5",
    "vue": "^3.5.22",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "gh-pages": "^6.3.0",
    "sass": "^1.105.2",
    "vite": "^7.1.7",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.1.1"
  }
}
