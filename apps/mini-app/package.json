{
  "name": "@avito/mini-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "clean": "rm -rf dist",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
