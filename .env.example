# Copy to .env and provide values locally. Never commit real credentials.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://avito:avito@localhost:5432/avito
REDIS_URL=redis://localhost:6379
MINI_APP_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

# Telegram is optional for local health checks, but required for auth and webhook handling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600

AVITO_API_CLIENT_ID=
AVITO_API_CLIENT_SECRET=

# Keep unset until the stage 0 controlled-order evidence selects one mode:
# AVITO_OFD, CHZ_MANUAL, or DIRECT_TRUE_API.
CHZ_SUBMISSION_MODE=
