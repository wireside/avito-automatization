# Copy to .env and provide values locally. Never commit real credentials.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://avito:avito@localhost:5432/avito
REDIS_URL=redis://localhost:6379
MINI_APP_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=

# Telegram is optional for local health checks, but required for auth and webhook handling.
# disabled | polling (local) | webhook (production)
TELEGRAM_MODE=disabled
# Public HTTPS URL, e.g. a development tunnel or production domain.
MINI_APP_URL=
# Tunnel hostname without https://. Never allow all Vite hosts.
MINI_APP_TUNNEL_HOST=
# For production: https://your-domain/webhooks/telegram
TELEGRAM_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600

# Server only. Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key backed up for the full marking lifecycle. Never expose as VITE_*.
MARKING_ENCRYPTION_KEY=
MARKING_ENCRYPTION_KEY_ID=local-v1

AVITO_API_CLIENT_ID=
AVITO_API_CLIENT_SECRET=

# Keep unset until the stage 0 controlled-order evidence selects one mode:
# AVITO_OFD, CHZ_MANUAL, or DIRECT_TRUE_API.
CHZ_SUBMISSION_MODE=

# Optional private chat ID used to verify the menu during setup.
TELEGRAM_SETUP_CHAT_ID=
